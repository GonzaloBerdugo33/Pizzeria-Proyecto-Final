@page "/pedido/{Id:int}"
@implements IDisposable
@using System.Net.Http.Json
@using Microsoft.AspNetCore.Authorization
@using Pizzeria.Cliente.Movil.DTOs
@using Pizzeria.Cliente.Movil.Servicios
@attribute [Authorize(Roles = "Cliente")]
@inject HttpClient Http

<MudText Typo="Typo.h5" Class="mb-3">Pedido N° @Id</MudText>

@if (error is not null)
{
    <MudAlert Severity="Severity.Error" Class="mb-3">@error</MudAlert>
}
else if (pedido is null)
{
    <MudProgressCircular Indeterminate="true" />
}
else
{
    @* ---- Estado actual (se actualiza solo) ---- *@
    <MudPaper Class="pa-4 mb-3 text-center">
        <MudChip T="string" Color="@ColorEstado" Size="Size.Large">@pedido.Estado</MudChip>
        @if (!Finalizado)
        {
            <MudText Typo="Typo.caption" Class="d-block mt-2" Color="Color.Secondary">Se actualiza automáticamente</MudText>
        }
    </MudPaper>

    @* ---- Código de entrega: solo envíos hechos desde la app ---- *@
    @if (!string.IsNullOrEmpty(pedido.CodigoEntrega) && !Finalizado)
    {
        <MudAlert Severity="Severity.Warning" Class="mb-3">
            Código de entrega: <b style="font-size:1.4rem;letter-spacing:4px">@pedido.CodigoEntrega</b><br />
            Dáselo al repartidor cuando recibas tu pedido.
        </MudAlert>
    }

    <MudPaper Class="pa-3 mb-3">
        @foreach (var d in pedido.Detalles)
        {
            <div class="d-flex justify-space-between mb-1">
                <span>@d.Cantidad × @d.NombreProducto</span>
                <span>@Formato.Dinero(d.Subtotal)</span>
            </div>
        }
        <MudDivider Class="my-2" />
        <div class="d-flex justify-space-between"><b>Total</b><b>@Formato.Dinero(pedido.Total)</b></div>
        <MudText Typo="Typo.caption" Color="Color.Secondary" Class="d-block mt-2">
            @pedido.TipoEntregaTexto@(string.IsNullOrEmpty(pedido.Direccion) ? "" : $" · {pedido.Direccion}")
        </MudText>
        <MudText Typo="Typo.caption" Color="Color.Secondary" Class="d-block">
            Pago: @pedido.MetodoPago · @(pedido.Pagado ? "Pagado" : "Pendiente de pago")
        </MudText>
    </MudPaper>

    <MudText Typo="Typo.subtitle1" Class="mb-1"><b>Seguimiento</b></MudText>
    <MudPaper Class="pa-3 mb-3">
        @foreach (var h in pedido.Historial.OrderBy(h => h.Fecha))
        {
            <div class="d-flex justify-space-between mb-1">
                <span>@h.Estado</span>
                <MudText Typo="Typo.caption" Color="Color.Secondary">@Formato.Fecha(h.Fecha)</MudText>
            </div>
        }
    </MudPaper>

    @* ---- Solo se cancela mientras está "Recibido" ---- *@
    @if (pedido.EstadoId == 1)
    {
        @if (!confirmandoCancelar)
        {
            <MudButton Variant="Variant.Outlined" Color="Color.Error" FullWidth="true" Class="mb-2"
                       OnClick="() => confirmandoCancelar = true">Cancelar pedido</MudButton>
        }
        else
        {
            <MudAlert Severity="Severity.Warning" Class="mb-2">¿Seguro que querés cancelar el pedido?</MudAlert>
            <MudButton Variant="Variant.Filled" Color="Color.Error" FullWidth="true" Class="mb-2"
                       Disabled="@cancelando" OnClick="Cancelar">Sí, cancelar</MudButton>
            <MudButton Variant="Variant.Text" FullWidth="true" Class="mb-2"
                       OnClick="() => confirmandoCancelar = false">No, volver</MudButton>
        }
    }

    <MudButton Href="/mis-pedidos" Variant="Variant.Text" FullWidth="true">Ver mis pedidos</MudButton>
}

@code {
    [Parameter] public int Id { get; set; }

    private PedidoDTO? pedido;
    private string? error;
    private bool confirmandoCancelar;
    private bool cancelando;
    private readonly CancellationTokenSource _cts = new();

    // 5 = Entregado, 6 = Cancelado: ya no cambia más
    private bool Finalizado => pedido is not null && (pedido.EstadoId == 5 || pedido.EstadoId == 6);

    private Color ColorEstado => pedido?.EstadoId switch
    {
        5 => Color.Success,
        6 => Color.Error,
        4 => Color.Info,
        _ => Color.Warning
    };

    protected override async Task OnInitializedAsync()
    {
        await Cargar();
        _ = Sondear(_cts.Token);
    }

    // Polling
    private async Task Sondear(CancellationToken ct)
    {
        using var timer = new PeriodicTimer(TimeSpan.FromSeconds(5));
        try
        {
            while (await timer.WaitForNextTickAsync(ct))
            {
                if (Finalizado) break;
                await Cargar();
                await InvokeAsync(StateHasChanged);
            }
        }
        catch (OperationCanceledException) { }
    }

    private async Task Cargar()
    {
        try
        {
            var r = await Http.GetAsync($"api/Pedido/{Id}");
            if (r.IsSuccessStatusCode)
            {
                pedido = await r.Content.ReadFromJsonAsync<PedidoDTO>();
                error = null;
            }
            else if (pedido is null)
            {
                error = "No se pudo cargar el pedido.";
            }
        }
        catch (Exception ex)
        {
            // Un corte de red durante el polling no tira abajo la pantalla
            if (pedido is null) error = $"Error de conexión: {ex.Message}";
        }
    }

    private async Task Cancelar()
    {
        cancelando = true;
        try
        {
            var r = await Http.PostAsync($"api/Pedido/{Id}/cancelar", null);
            if (!r.IsSuccessStatusCode)
                error = await r.Content.ReadAsStringAsync();
            await Cargar();
        }
        catch (Exception ex)
        {
            error = $"No se pudo cancelar: {ex.Message}";
        }
        finally
        {
            cancelando = false;
            confirmandoCancelar = false;
        }
    }

    public void Dispose()
    {
        _cts.Cancel();
        _cts.Dispose();
    }
}