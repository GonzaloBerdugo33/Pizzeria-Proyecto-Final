@inherits LayoutComponentBase
@implements IDisposable
@using Pizzeria.Cliente.Movil.Servicios
@inject IAuthService AuthService
@inject NavigationManager Nav

<MudThemeProvider Theme="_tema" IsDarkMode="true" />
<MudPopoverProvider />
<MudDialogProvider />
<MudSnackbarProvider />

<MudLayout>
    <MudAppBar Elevation="1">
        <MudIconButton Icon="@Icons.Material.Filled.Menu" Color="Color.Inherit" Edge="Edge.Start" OnClick="AbrirCerrarMenu" />
        <MudText Typo="Typo.h6" Class="ml-2" Style="font-family:Poppins,sans-serif;font-weight:700">🍕 Pizzería</MudText>
    </MudAppBar>

    <MudDrawer @bind-Open="_menuAbierto" Elevation="3" Variant="DrawerVariant.Temporary">
        <MudDrawerHeader>
            <MudText Typo="Typo.subtitle1" Color="Color.Primary"><b>Menú</b></MudText>
        </MudDrawerHeader>
        <MudNavMenu>
            <MudNavLink Href="/" Match="NavLinkMatch.All" Icon="@Icons.Material.Filled.LocalPizza">Menú</MudNavLink>

            <AuthorizeView>
                <NotAuthorized>
                    <MudNavLink Href="/Login" Icon="@Icons.Material.Filled.Login">Iniciar sesión</MudNavLink>
                    <MudNavLink Href="/registro" Icon="@Icons.Material.Filled.PersonAdd">Crear cuenta</MudNavLink>
                </NotAuthorized>
            </AuthorizeView>

            <AuthorizeView Roles="Cliente">
                <MudNavLink Href="/carrito" Icon="@Icons.Material.Filled.ShoppingCart">Carrito</MudNavLink>
                <MudNavLink Href="/mis-pedidos" Icon="@Icons.Material.Filled.ReceiptLong">Mis pedidos</MudNavLink>
            </AuthorizeView>

            <AuthorizeView>
                <Authorized>
                    <MudNavLink OnClick="CerrarSesion" Icon="@Icons.Material.Filled.Logout">Cerrar sesión</MudNavLink>
                </Authorized>
            </AuthorizeView>
        </MudNavMenu>
    </MudDrawer>

    <MudMainContent Class="pa-3">
        @Body
    </MudMainContent>
</MudLayout>

@code {
    private bool _menuAbierto;

    private readonly MudTheme _tema = new()
    {
        PaletteDark = new PaletteDark
        {
            Primary = "#FF5722",
            Secondary = "#FFC107",
            Background = "#0D0D0D",
            Surface = "#161616",
            TextPrimary = "#FFFFFF",
            TextSecondary = "#9E9E9E",
            AppbarBackground = "#121212",
            DrawerBackground = "#121212"
        },
        Typography = new Typography
        {
            Default = new DefaultTypography { FontFamily = new[] { "Inter", "sans-serif" } },
            H1 = new H1Typography { FontFamily = new[] { "Poppins", "sans-serif" }, FontWeight = "800" },
            H2 = new H2Typography { FontFamily = new[] { "Poppins", "sans-serif" }, FontWeight = "700" },
            H3 = new H3Typography { FontFamily = new[] { "Poppins", "sans-serif" }, FontWeight = "600" },
            H5 = new H5Typography { FontFamily = new[] { "Poppins", "sans-serif" }, FontWeight = "600" },
            H6 = new H6Typography { FontFamily = new[] { "Poppins", "sans-serif" }, FontWeight = "600" },
            Button = new ButtonTypography { FontFamily = new[] { "Poppins", "sans-serif" }, FontWeight = "600", TextTransform = "none" }
        },
        LayoutProperties = new LayoutProperties { DefaultBorderRadius = "12px" }
    };

    protected override void OnInitialized()
    {
        Nav.LocationChanged += AlCambiarDePantalla;
    }

    private void AlCambiarDePantalla(object? sender, Microsoft.AspNetCore.Components.Routing.LocationChangedEventArgs e)
    {
        _menuAbierto = false;
        StateHasChanged();
    }

    private void AbrirCerrarMenu() => _menuAbierto = !_menuAbierto;

    private async Task CerrarSesion()
    {
        await AuthService.LogoutAsync();
        _menuAbierto = false;
        Nav.NavigateTo("/");
    }

    public void Dispose()
    {
        Nav.LocationChanged -= AlCambiarDePantalla;
    }
}