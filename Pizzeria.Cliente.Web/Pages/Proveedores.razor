@page "/Proveedores"
@using Microsoft.AspNetCore.Authorization
@using Pizzeria.Cliente.Web.DTOs
@attribute [Authorize(Roles = "Administrador")]
@inject HttpClient Http
@inject ISnackbar Snackbar
@inject IDialogService Dialogs

<div class="d-flex justify-space-between align-center mb-4">
    <MudText Typo="Typo.h5">Proveedores</MudText>
    <MudButton Variant="Variant.Filled" Color="Color.Primary" Href="/Proveedores/Nuevo">+ Nuevo proveedor</MudButton>
</div>

<MudTextField T="string" @bind-Value="filtro" Immediate="true" Variant="Variant.Outlined" Margin="Margin.Dense"
              Placeholder="Buscar por razón social..." Adornment="Adornment.Start"
              AdornmentIcon="@Icons.Material.Filled.Search" Class="mb-3" />

@if (proveedores is null)
{
    <MudProgressCircular Indeterminate="true" />
}
else
{
    <MudTable Items="Filtrados" Hover="true" Outlined="true" Elevation="0" Breakpoint="Breakpoint.Sm" RowsPerPage="10">
        <HeaderContent>
            <MudTh>ID</MudTh>
            <MudTh>Razón social</MudTh>
            <MudTh>CUIT</MudTh>
            <MudTh>Teléfono</MudTh>
            <MudTh>Correo</MudTh>
            <MudTh Style="text-align:right">Acciones</MudTh>
        </HeaderContent>
        <RowTemplate>
            <MudTd DataLabel="ID">@context.Id</MudTd>
            <MudTd DataLabel="Razón social">@context.RazonSocial</MudTd>
            <MudTd DataLabel="CUIT">@context.CUIT</MudTd>
            <MudTd DataLabel="Teléfono">@context.Telefono</MudTd>
            <MudTd DataLabel="Correo">@context.Email</MudTd>
            <MudTd Style="text-align:right">
                <MudIconButton Icon="@Icons.Material.Filled.Delete" Size="Size.Small" Color="Color.Error"
                               OnClick="() => Eliminar(context)" />
            </MudTd>
        </RowTemplate>
        <NoRecordsContent>
            <MudText>No hay proveedores para mostrar.</MudText>
        </NoRecordsContent>
        <PagerContent>
            <MudTablePager RowsPerPageString="Filas por página" InfoFormat="{first_item}-{last_item} de {all_items}" />
        </PagerContent>
    </MudTable>
}

@code {
    private List<ListarProveedorDTO>? proveedores;
    private string filtro = string.Empty;

    private IEnumerable<ListarProveedorDTO> Filtrados =>
        (proveedores ?? new()).Where(p =>
            string.IsNullOrWhiteSpace(filtro) ||
            p.RazonSocial.Contains(filtro.Trim(), StringComparison.OrdinalIgnoreCase));

    protected override async Task OnInitializedAsync() => await Cargar();

    private async Task Cargar()
    {
        try
        {
            proveedores = await Http.GetFromJsonAsync<List<ListarProveedorDTO>>("api/Proveedor?pagina=1&tamanoPagina=1000") ?? new();
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Error al cargar proveedores: {ex.Message}", Severity.Error);
        }
    }

    private async Task Eliminar(ListarProveedorDTO p)
    {
        var confirmar = await Dialogs.ShowMessageBoxAsync(
            "Eliminar proveedor", $"¿Eliminar a '{p.RazonSocial}'?",
            yesText: "Sí, eliminar", cancelText: "No");
        if (confirmar != true) return;

        try
        {
            var r = await Http.DeleteAsync($"api/Proveedor/{p.Id}");
            if (r.IsSuccessStatusCode)
            {
                Snackbar.Add("Proveedor eliminado.", Severity.Success);
                await Cargar();
            }
            else
            {
                Snackbar.Add(await r.Content.ReadAsStringAsync(), Severity.Error);
            }
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Error de red: {ex.Message}", Severity.Error);
        }
    }
}