@page "/Usuarios"
@using Microsoft.AspNetCore.Authorization
@using Pizzeria.Cliente.Web.DTOs
@attribute [Authorize(Roles = "Administrador")]
@inject HttpClient Http
@inject ISnackbar Snackbar
@inject IDialogService Dialogs

<div class="d-flex justify-space-between align-center mb-4">
    <MudText Typo="Typo.h5">Usuarios</MudText>
    <MudButton Variant="Variant.Filled" Color="Color.Primary" Href="/Register">+ Nuevo usuario</MudButton>
</div>

<MudTextField T="string" @bind-Value="filtro" Immediate="true" Variant="Variant.Outlined" Margin="Margin.Dense"
              Placeholder="Buscar por nombre o email..." Adornment="Adornment.Start"
              AdornmentIcon="@Icons.Material.Filled.Search" Class="mb-3" />

@if (usuarios is null)
{
    <MudProgressCircular Indeterminate="true" />
}
else
{
    <MudTable Items="Filtrados" Hover="true" Outlined="true" Elevation="0" Breakpoint="Breakpoint.Sm" RowsPerPage="10">
        <HeaderContent>
            <MudTh>ID</MudTh>
            <MudTh>Nombre</MudTh>
            <MudTh>Correo</MudTh>
            <MudTh>Rol</MudTh>
            <MudTh Style="text-align:right">Acciones</MudTh>
        </HeaderContent>
        <RowTemplate>
            <MudTd DataLabel="ID">@context.Id</MudTd>
            <MudTd DataLabel="Nombre">@context.Nombre</MudTd>
            <MudTd DataLabel="Correo">@context.Email</MudTd>
            <MudTd DataLabel="Rol">
                <MudChip T="string" Size="Size.Small" Variant="Variant.Outlined" Color="@ColorRol(context.Rol)">@context.Rol</MudChip>
            </MudTd>
            <MudTd Style="text-align:right">
                <MudIconButton Icon="@Icons.Material.Filled.Delete" Size="Size.Small" Color="Color.Error"
                               OnClick="() => Eliminar(context)" />
            </MudTd>
        </RowTemplate>
        <NoRecordsContent>
            <MudText>No hay usuarios para mostrar.</MudText>
        </NoRecordsContent>
        <PagerContent>
            <MudTablePager RowsPerPageString="Filas por página" InfoFormat="{first_item}-{last_item} de {all_items}" />
        </PagerContent>
    </MudTable>
}

@code {
    private List<UsuarioDTO>? usuarios;
    private string filtro = string.Empty;

    private IEnumerable<UsuarioDTO> Filtrados =>
        (usuarios ?? new()).Where(u =>
            string.IsNullOrWhiteSpace(filtro) ||
            u.Nombre.Contains(filtro.Trim(), StringComparison.OrdinalIgnoreCase) ||
            u.Email.Contains(filtro.Trim(), StringComparison.OrdinalIgnoreCase));

    private static Color ColorRol(string rol) => rol switch
    {
        "Administrador" => Color.Primary,
        "Cajero" => Color.Info,
        _ => Color.Default
    };

    protected override async Task OnInitializedAsync() => await Cargar();

    private async Task Cargar()
    {
        try
        {
            usuarios = await Http.GetFromJsonAsync<List<UsuarioDTO>>("api/Usuario") ?? new();
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Error al cargar usuarios: {ex.Message}", Severity.Error);
        }
    }

    private async Task Eliminar(UsuarioDTO u)
    {
        var confirmar = await Dialogs.ShowMessageBoxAsync(
            "Eliminar usuario", $"¿Eliminar al usuario '{u.Email}'?",
            yesText: "Sí, eliminar", cancelText: "No");
        if (confirmar != true) return;

        try
        {
            var r = await Http.DeleteAsync($"api/Usuario/{u.Id}");
            if (r.IsSuccessStatusCode)
            {
                Snackbar.Add("Usuario eliminado.", Severity.Success);
                await Cargar();
            }
            else
            {
                Snackbar.Add(await r.Content.ReadAsStringAsync(), Severity.Error);
            }
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Error de red: {ex.Message}", Severity.Error);
        }
    }
}