@page "/"
@attribute [Authorize(Roles = "Cajero,Administrador")]
@using Pizzeria.Cliente.Web.Componentes
@using Pizzeria.Cliente.Web.DTOs
@using Pizzeria.Cliente.Web.Servicios

<AuthorizeView Roles="Cajero">
    <Authorized>
        @* El cajero opera: pedidos, productos y venta en una sola pantalla *@
        <MudGrid Spacing="3">
            <MudItem xs="12" md="4">
                <PedidosActivos />
            </MudItem>
            <MudItem xs="12" md="4">
                <ProductosCaja @ref="productos" OnAgregar="Agregar" />
            </MudItem>
            <MudItem xs="12" md="4">
                <VentaActual Carrito="carrito" OnVentaRegistrada="VentaRegistrada" />
            </MudItem>
        </MudGrid>
    </Authorized>
    <NotAuthorized>
        @* El administrador solo supervisa: los pedidos ocupan todo el ancho *@
        <PedidosActivos Ancho="true" />
    </NotAuthorized>
</AuthorizeView>

@code {
    // El carrito de la venta vive acá: lo comparten la lista de productos y la venta actual
    private readonly CarritoVenta carrito = new();
    private ProductosCaja? productos;

    private void Agregar(ProductoDTO producto) => carrito.Agregar(producto);

    // Después de una venta se recarga la lista para ver el stock nuevo
    private async Task VentaRegistrada()
    {
        if (productos is not null) await productos.Recargar();
    }
}