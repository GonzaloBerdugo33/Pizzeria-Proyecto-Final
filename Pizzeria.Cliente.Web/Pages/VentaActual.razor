@using System.Net.Http.Json
@using Pizzeria.Cliente.Web.DTOs
@using Pizzeria.Cliente.Web.Servicios
@inject HttpClient Http
@inject ISnackbar Snackbar

<MudPaper Class="pa-4" Elevation="1">
    <MudText Typo="Typo.h6" Class="mb-3">Venta actual</MudText>

    @* ---------- 1. Cliente ---------- *@
    <MudText Typo="Typo.subtitle2" Class="mb-1">Cliente</MudText>
    @if (cliente is null)
    {
        <MudTextField T="string" @bind-Value="busqueda" Immediate="true" Variant="Variant.Outlined" Margin="Margin.Dense"
                      Placeholder="Buscar por teléfono o nombre..." Adornment="Adornment.Start"
                      AdornmentIcon="@Icons.Material.Filled.Search" />

        @foreach (var c in Coincidencias)
        {
            <MudPaper Outlined="true" Class="pa-2 mt-1" Style="cursor:pointer" @onclick="() => Elegir(c)">
                <b>@c.Nombre</b> · @c.Telefono
            </MudPaper>
        }
        @if (busqueda.Trim().Length >= 2 && !Coincidencias.Any())
        {
            <MudText Typo="Typo.caption" Color="Color.Secondary">No hay coincidencias.</MudText>
        }

        <MudButton Variant="Variant.Text" Size="Size.Small" Class="mt-1"
                   OnClick="() => mostrarAlta = !mostrarAlta">Cliente nuevo</MudButton>

        @if (mostrarAlta)
        {
            <MudPaper Outlined="true" Class="pa-2 mt-1">
                <MudTextField T="string" @bind-Value="altaNombre" Label="Nombre" Variant="Variant.Outlined" Margin="Margin.Dense" />
                <MudTextField T="string" @bind-Value="altaTelefono" Label="Teléfono (solo números)" InputType="InputType.Telephone"
                              Variant="Variant.Outlined" Margin="Margin.Dense" Class="mt-2" />
                <MudButton Variant="Variant.Filled" Color="Color.Primary" Size="Size.Small" Class="mt-2"
                           Disabled="@guardandoCliente" OnClick="CrearCliente">Guardar cliente</MudButton>
            </MudPaper>
        }
    }
    else
    {
        <MudPaper Outlined="true" Class="pa-2 d-flex justify-space-between align-center">
            <span><b>@cliente.Nombre</b> · @cliente.Telefono</span>
            <MudButton Size="Size.Small" Variant="Variant.Text" OnClick="Cambiar">Cambiar</MudButton>
        </MudPaper>
    }

    @* ---------- 2. Entrega ---------- *@
    <MudText Typo="Typo.subtitle2" Class="mt-4 mb-1">Entrega</MudText>
    <MudRadioGroup T="int" @bind-Value="tipoEntrega">
        <MudRadio T="int" Value="1">Retiro</MudRadio>
        <MudRadio T="int" Value="2">Envío</MudRadio>
    </MudRadioGroup>

    @if (tipoEntrega == 2)
    {
        @if (cliente is null)
        {
            <MudText Typo="Typo.caption" Color="Color.Secondary">Elegí un cliente para ver sus direcciones.</MudText>
        }
        else
        {
            @if (direcciones.Count > 0)
            {
                <MudRadioGroup T="int" @bind-Value="direccionId">
                    @foreach (var d in direcciones)
                    {
                        <MudRadio T="int" Value="@d.Id">@d.Texto</MudRadio>
                    }
                    <MudRadio T="int" Value="0">Otra dirección</MudRadio>
                </MudRadioGroup>
            }
            @if (direccionId == 0)
            {
                <MudTextField T="string" @bind-Value="nueva.Calle" Label="Calle" Variant="Variant.Outlined" Margin="Margin.Dense" Class="mt-1" />
                <MudTextField T="string" @bind-Value="nueva.Altura" Label="Altura" Variant="Variant.Outlined" Margin="Margin.Dense" Class="mt-2" />
                <MudTextField T="string" @bind-Value="nueva.PisoDepto" Label="Piso / Depto (opcional)" Variant="Variant.Outlined" Margin="Margin.Dense" Class="mt-2" />
                <MudTextField T="string" @bind-Value="nueva.Aclaraciones" Label="Aclaraciones (opcional)" Variant="Variant.Outlined" Margin="Margin.Dense" Class="mt-2" />
            }
        }
    }

    @* ---------- 3. Forma de pago ---------- *@
    <MudText Typo="Typo.subtitle2" Class="mt-4 mb-1">Forma de pago</MudText>
    <MudRadioGroup T="int" @bind-Value="metodoPagoId">
        <MudRadio T="int" Value="1">Efectivo</MudRadio>
        <MudRadio T="int" Value="2">Tarjeta</MudRadio>
        <MudRadio T="int" Value="3">Mercado Pago</MudRadio>
    </MudRadioGroup>
    <MudText Typo="Typo.caption" Color="Color.Secondary" Class="d-block">
        Efectivo se cobra al entregar · Tarjeta queda pagada · Mercado Pago queda pendiente hasta confirmar.
    </MudText>

    @* ---------- 4. Carrito ---------- *@
    <MudText Typo="Typo.subtitle2" Class="mt-4 mb-1">Carrito</MudText>
    @if (Carrito.Items.Count == 0)
    {
        <MudText Typo="Typo.body2" Color="Color.Secondary">Todavía no agregaste productos.</MudText>
    }
    else
    {
        @foreach (var i in Carrito.Items)
        {
            <div class="d-flex align-center py-1" style="gap:6px">
                <div style="flex:1;min-width:0">
                    <MudText Typo="Typo.body2"><b>@i.Producto.Nombre</b></MudText>
                    <MudText Typo="Typo.caption" Color="Color.Secondary">@Formato.Dinero(i.Producto.Precio) c/u</MudText>
                </div>
                <MudIconButton Icon="@Icons.Material.Filled.Remove" Size="Size.Small" Variant="Variant.Outlined"
                               OnClick="() => Carrito.Disminuir(i.Producto.Id)" />
                <span>@i.Cantidad</span>
                <MudIconButton Icon="@Icons.Material.Filled.Add" Size="Size.Small" Variant="Variant.Outlined"
                               Disabled="@(i.Cantidad >= i.Producto.Stock)"
                               OnClick="() => Carrito.Aumentar(i.Producto.Id)" />
                <MudIconButton Icon="@Icons.Material.Filled.Delete" Size="Size.Small" Color="Color.Error"
                               OnClick="() => Carrito.Quitar(i.Producto.Id)" />
                <span style="min-width:80px;text-align:right"><b>@Formato.Dinero(i.Subtotal)</b></span>
            </div>
        }
    }

    <MudDivider Class="my-3" />
    <div class="d-flex justify-space-between align-baseline">
        <MudText Typo="Typo.subtitle1"><b>Total</b></MudText>
        <MudText Typo="Typo.h5"><b>@Formato.Dinero(Carrito.Total)</b></MudText>
    </div>

    @if (error is not null)
    {
        <MudAlert Severity="Severity.Error" Class="mt-3">@error</MudAlert>
    }

    <MudButton Variant="Variant.Filled" Color="Color.Primary" FullWidth="true" Size="Size.Large" Class="mt-3"
               Disabled="@registrando" OnClick="Registrar">
        @(registrando ? "Registrando..." : "Registrar venta")
    </MudButton>
    <MudText Typo="Typo.caption" Color="Color.Secondary" Class="d-block mt-2">
        Descuenta el stock y el pedido entra como Recibido.
    </MudText>
</MudPaper>

@code {
    // El carrito lo crea y guarda la página de caja; acá solo se muestra y se modifica
    [Parameter] public CarritoVenta Carrito { get; set; } = default!;
    [Parameter] public EventCallback OnVentaRegistrada { get; set; }

    private List<ClienteDTO> clientes = new();
    private ClienteDTO? cliente;
    private string busqueda = string.Empty;

    private bool mostrarAlta, guardandoCliente;
    private string altaNombre = string.Empty, altaTelefono = string.Empty;

    private int tipoEntrega = 1;             // 1 Retiro, 2 Envío
    private int metodoPagoId = 1;            // 1 Efectivo, 2 Tarjeta, 3 Mercado Pago
    private List<DireccionDTO> direcciones = new();
    private int direccionId;                 // 0 = dirección nueva
    private DireccionDTO nueva = new();

    private string? error;
    private bool registrando;

    private record VentaCreada(int Id);

    // Muestra hasta 5 clientes que coinciden con lo escrito (por teléfono o por nombre)
    private IEnumerable<ClienteDTO> Coincidencias
    {
        get
        {
            var texto = busqueda.Trim();
            if (texto.Length < 2) return Enumerable.Empty<ClienteDTO>();

            var digitos = new string(texto.Where(char.IsDigit).ToArray());
            return clientes
                .Where(c => (digitos.Length > 0 && c.Telefono.Contains(digitos))
                         || c.Nombre.Contains(texto, StringComparison.OrdinalIgnoreCase))
                .Take(5);
        }
    }

    protected override async Task OnInitializedAsync() => await CargarClientes();

    private async Task CargarClientes()
    {
        try
        {
            clientes = await Http.GetFromJsonAsync<List<ClienteDTO>>("api/Cliente?pagina=1&tamanoPagina=1000") ?? new();
        }
        catch (Exception ex)
        {
            error = $"No se pudieron cargar los clientes: {ex.Message}";
        }
    }

    private async Task Elegir(ClienteDTO c)
    {
        cliente = c;
        busqueda = string.Empty;
        mostrarAlta = false;
        await CargarDirecciones();
    }

    private void Cambiar()
    {
        cliente = null;
        direcciones = new();
        direccionId = 0;
    }

    private async Task CargarDirecciones()
    {
        direcciones = new();
        direccionId = 0;
        if (cliente is null) return;

        try
        {
            direcciones = await Http.GetFromJsonAsync<List<DireccionDTO>>($"api/Pedido/direcciones/{cliente.Id}") ?? new();
            if (direcciones.Count > 0) direccionId = direcciones[0].Id;
        }
        catch
        {
            // Si falla, igual puede cargar una dirección nueva
        }
    }

    // Alta rápida: nombre y teléfono alcanzan para anotar un pedido por teléfono o mostrador
    private async Task CrearCliente()
    {
        error = null;
        var telefono = new string(altaTelefono.Where(char.IsDigit).ToArray());

        if (string.IsNullOrWhiteSpace(altaNombre) || telefono.Length == 0)
        {
            error = "Completá nombre y teléfono del cliente nuevo.";
            return;
        }

        guardandoCliente = true;
        try
        {
            var r = await Http.PostAsJsonAsync("api/Cliente", new ClienteDTO { Nombre = altaNombre.Trim(), Telefono = telefono });
            if (r.IsSuccessStatusCode)
            {
                var creado = await r.Content.ReadFromJsonAsync<ClienteDTO>();
                if (creado is not null)
                {
                    clientes.Add(creado);
                    altaNombre = altaTelefono = string.Empty;
                    await Elegir(creado);
                }
            }
            else
            {
                error = await r.Content.ReadAsStringAsync();   // ej: ya existe un cliente con ese teléfono
            }
        }
        catch (Exception ex)
        {
            error = $"No se pudo crear el cliente: {ex.Message}";
        }
        finally
        {
            guardandoCliente = false;
        }
    }

    private async Task Registrar()
    {
        error = null;

        if (cliente is null) { error = "Elegí un cliente."; return; }
        if (Carrito.Items.Count == 0) { error = "El carrito está vacío."; return; }
        if (tipoEntrega == 2 && direccionId == 0 &&
            (string.IsNullOrWhiteSpace(nueva.Calle) || string.IsNullOrWhiteSpace(nueva.Altura)))
        {
            error = "Completá calle y altura para el envío.";
            return;
        }

        var venta = new CrearVentaDTO
        {
            ClienteId = cliente.Id,
            TipoEntrega = tipoEntrega,
            MetodoPagoId = metodoPagoId,
            Detalles = Carrito.Items
                .Select(i => new CrearPedidoDetalleDTO { ProductoId = i.Producto.Id, Cantidad = i.Cantidad })
                .ToList()
        };

        if (tipoEntrega == 2)
        {
            if (direccionId != 0) venta.DireccionId = direccionId;
            else venta.Direccion = nueva;
        }

        registrando = true;
        try
        {
            var r = await Http.PostAsJsonAsync("api/Pedido/venta", venta);

            if (r.IsSuccessStatusCode)
            {
                var creada = await r.Content.ReadFromJsonAsync<VentaCreada>();
                Snackbar.Add($"Venta registrada: pedido N° {creada?.Id}", Severity.Success);

                Carrito.Vaciar();
                Reiniciar();
                await OnVentaRegistrada.InvokeAsync();
            }
            else
            {
                error = await r.Content.ReadAsStringAsync();   // ej: falta de stock
            }
        }
        catch (Exception ex)
        {
            error = $"No se pudo registrar la venta: {ex.Message}";
        }
        finally
        {
            registrando = false;
        }
    }

    private void Reiniciar()
    {
        cliente = null;
        busqueda = string.Empty;
        tipoEntrega = 1;
        metodoPagoId = 1;
        direcciones = new();
        direccionId = 0;
        nueva = new();
    }
}