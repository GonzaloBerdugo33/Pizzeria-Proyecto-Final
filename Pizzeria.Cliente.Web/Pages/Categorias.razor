@page "/Categoria"
@using Microsoft.AspNetCore.Authorization
@using Pizzeria.Cliente.Web.DTOs
@attribute [Authorize(Roles = "Administrador")]
@inject HttpClient Http
@inject ISnackbar Snackbar
@inject IDialogService Dialogs

<MudText Typo="Typo.h5" Class="mb-4">Categorías</MudText>

<MudPaper Class="pa-4 mb-4" Elevation="1">
    <div class="d-flex flex-wrap align-center" style="gap:12px">
        <MudTextField T="string" @bind-Value="nuevoNombre" Label="Nueva categoría" Variant="Variant.Outlined"
                      Margin="Margin.Dense" Style="flex:1;min-width:220px" />
        <MudButton Variant="Variant.Filled" Color="Color.Primary" OnClick="Agregar">Agregar</MudButton>
    </div>
</MudPaper>

@if (categorias is null)
{
    <MudProgressCircular Indeterminate="true" />
}
else
{
    <MudTable Items="categorias" Hover="true" Outlined="true" Elevation="0">
        <HeaderContent>
            <MudTh>ID</MudTh>
            <MudTh>Nombre</MudTh>
            <MudTh Style="text-align:right">Acciones</MudTh>
        </HeaderContent>
        <RowTemplate>
            <MudTd DataLabel="ID">@context.Id</MudTd>
            <MudTd DataLabel="Nombre">@context.Nombre</MudTd>
            <MudTd Style="text-align:right">
                <MudIconButton Icon="@Icons.Material.Filled.Delete" Size="Size.Small" Color="Color.Error"
                               OnClick="() => Eliminar(context)" />
            </MudTd>
        </RowTemplate>
        <NoRecordsContent>
            <MudText>Todavía no hay categorías.</MudText>
        </NoRecordsContent>
    </MudTable>
}

@code {
    private List<CategoriaProductoDTO>? categorias;
    private string nuevoNombre = string.Empty;

    protected override async Task OnInitializedAsync() => await Cargar();

    private async Task Cargar()
    {
        try
        {
            categorias = await Http.GetFromJsonAsync<List<CategoriaProductoDTO>>("api/CategoriaProducto") ?? new();
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Error al cargar categorías: {ex.Message}", Severity.Error);
        }
    }

    private async Task Agregar()
    {
        if (string.IsNullOrWhiteSpace(nuevoNombre))
        {
            Snackbar.Add("El nombre de la categoría no puede estar vacío.", Severity.Warning);
            return;
        }

        try
        {
            var r = await Http.PostAsJsonAsync("api/CategoriaProducto", new CategoriaProductoDTO { Nombre = nuevoNombre.Trim() });
            if (r.IsSuccessStatusCode)
            {
                Snackbar.Add("Categoría guardada.", Severity.Success);
                nuevoNombre = string.Empty;
                await Cargar();
            }
            else
            {
                Snackbar.Add(await r.Content.ReadAsStringAsync(), Severity.Error);
            }
        }
        catch (Exception ex)
        {
            Snackbar.Add($"No se pudo guardar: {ex.Message}", Severity.Error);
        }
    }

    private async Task Eliminar(CategoriaProductoDTO c)
    {
        var confirmar = await Dialogs.ShowMessageBoxAsync(
            "Eliminar categoría", $"¿Eliminar la categoría '{c.Nombre}'?",
            yesText: "Sí, eliminar", cancelText: "No");
        if (confirmar != true) return;

        try
        {
            var r = await Http.DeleteAsync($"api/CategoriaProducto/{c.Id}");
            if (r.IsSuccessStatusCode)
            {
                Snackbar.Add("Categoría eliminada.", Severity.Success);
                await Cargar();
            }
            else
            {
                Snackbar.Add(await r.Content.ReadAsStringAsync(), Severity.Error);
            }
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Error de red: {ex.Message}", Severity.Error);
        }
    }
}