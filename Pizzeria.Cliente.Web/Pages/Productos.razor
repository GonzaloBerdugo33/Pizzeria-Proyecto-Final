@page "/Productos"
@using Microsoft.AspNetCore.Authorization
@using Pizzeria.Cliente.Web.DTOs
@using Pizzeria.Cliente.Web.Servicios
@attribute [Authorize(Roles = "Administrador")]
@inject HttpClient Http
@inject ISnackbar Snackbar
@inject IDialogService Dialogs
@inject NavigationManager Navigation

<div class="d-flex justify-space-between align-center mb-3">
    <MudText Typo="Typo.h5">Productos</MudText>
    <MudButton Variant="Variant.Filled" Color="Color.Primary" Href="/Productos/Nuevo">+ Nuevo producto</MudButton>
</div>

<MudTextField T="string" @bind-Value="filtro" Immediate="true" Variant="Variant.Outlined" Margin="Margin.Dense"
              Placeholder="Buscar producto..." Adornment="Adornment.Start"
              AdornmentIcon="@Icons.Material.Filled.Search" Class="mb-2" />

<div class="d-flex flex-wrap mb-4" style="gap:6px">
    <MudButton Size="Size.Small" Color="Color.Primary"
               Variant="@(categoria == "" ? Variant.Filled : Variant.Outlined)"
               OnClick="() => categoria = string.Empty">Todas</MudButton>
    @foreach (var c in Categorias)
    {
        <MudButton Size="Size.Small" Color="Color.Primary"
                   Variant="@(categoria == c ? Variant.Filled : Variant.Outlined)"
                   OnClick="() => categoria = c">@c</MudButton>
    }
</div>

@if (productos is null)
{
    <MudProgressCircular Indeterminate="true" />
}
else if (!Visibles.Any())
{
    <MudText Color="Color.Secondary">No hay productos para mostrar.</MudText>
}
else
{
    <MudGrid Spacing="3">
        @foreach (var p in Visibles)
        {
            <MudItem xs="12" sm="6" md="4" lg="3">
                <MudCard Class="d-flex flex-column" Style="@(p.Disponible ? "height:100%" : "height:100%;opacity:0.65")">

                    @if (!string.IsNullOrEmpty(p.ImagenUrl))
                    {
                        <img src="@UrlImagen(p.ImagenUrl)" alt="@p.Nombre" style="width:100%;height:150px;object-fit:cover" />
                    }
                    else
                    {
                        <div class="d-flex align-center justify-center" style="height:150px;background:#f1f5f9;color:#94a3b8">Sin imagen</div>
                    }

                    <MudCardContent>
                        <MudText Typo="Typo.subtitle1"><b>@p.Nombre</b></MudText>
                        <MudText Typo="Typo.caption" Color="Color.Secondary">@p.CategoriaNombre · @p.ProveedorNombre</MudText>
                        <MudText Typo="Typo.body2" Class="my-2"
                                 Style="display:-webkit-box;-webkit-line-clamp:2;-webkit-box-orient:vertical;overflow:hidden;min-height:2.6em">
                            @(string.IsNullOrWhiteSpace(p.Descripcion) ? "Sin descripción" : p.Descripcion)
                        </MudText>
                        <div class="d-flex justify-space-between align-baseline">
                            <MudText Typo="Typo.h6"><b>@Formato.Dinero(p.Precio)</b></MudText>
                            @if (p.Stock == 0)
                            {
                                <MudChip T="string" Size="Size.Small" Color="Color.Error">Agotado</MudChip>
                            }
                            else
                            {
                                <MudText Typo="Typo.caption">Stock @p.Stock</MudText>
                            }
                        </div>
                    </MudCardContent>

                    <MudCardActions Class="mt-auto">
                        <MudSwitch T="bool" Value="@p.Disponible" Color="Color.Success" Label="Disponible"
                                   ValueChanged="@((bool v) => CambiarDisponible(p, v))" />
                        <MudSpacer />
                        <MudIconButton Icon="@Icons.Material.Filled.Edit" Size="Size.Small"
                                       OnClick="() => Editar(p)" />
                        <MudIconButton Icon="@Icons.Material.Filled.Delete" Size="Size.Small" Color="Color.Error"
                                       OnClick="() => Eliminar(p)" />
                    </MudCardActions>
                </MudCard>
            </MudItem>
        }
    </MudGrid>
}

@code {
    private List<ProductoDTO>? productos;
    private string filtro = string.Empty;
    private string categoria = string.Empty;

    // Solo productos activos: los dados de baja no aparecen
    private IEnumerable<ProductoDTO> Activos => (productos ?? new()).Where(p => p.Activo);

    private IEnumerable<string> Categorias =>
        Activos.Select(p => p.CategoriaNombre ?? "Otros").Distinct().OrderBy(c => c);

    private IEnumerable<ProductoDTO> Visibles => Activos.Where(p =>
        (categoria == "" || (p.CategoriaNombre ?? "Otros") == categoria) &&
        (string.IsNullOrWhiteSpace(filtro) || p.Nombre.Contains(filtro.Trim(), StringComparison.OrdinalIgnoreCase)));

    protected override async Task OnInitializedAsync() => await Cargar();

    private async Task Cargar()
    {
        try
        {
            productos = await Http.GetFromJsonAsync<List<ProductoDTO>>("api/Producto?pagina=1&tamanoPagina=1000") ?? new();
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Error al cargar productos: {ex.Message}", Severity.Error);
        }
    }

    private string UrlImagen(string ruta) => $"{Http.BaseAddress}{ruta.TrimStart('/')}";

    // Prende o apaga un producto sin tocar el stock (por ejemplo, si falta un ingrediente)
    private async Task CambiarDisponible(ProductoDTO p, bool valor)
    {
        try
        {
            var r = await Http.PatchAsJsonAsync($"api/Producto/{p.Id}/disponible", new { Disponible = valor });
            if (!r.IsSuccessStatusCode)
                Snackbar.Add(await r.Content.ReadAsStringAsync(), Severity.Error);
            await Cargar();
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Error de conexión: {ex.Message}", Severity.Error);
        }
    }

    private void Editar(ProductoDTO p) => Navigation.NavigateTo($"/Productos/Actualizar/{p.Id}");

    private async Task Eliminar(ProductoDTO p)
    {
        var confirmar = await Dialogs.ShowMessageBoxAsync(
            "Dar de baja",
            $"¿Dar de baja el producto '{p.Nombre}'?",
            yesText: "Sí, dar de baja", cancelText: "No");
        if (confirmar != true) return;

        try
        {
            var r = await Http.DeleteAsync($"api/Producto/{p.Id}");
            if (r.IsSuccessStatusCode)
            {
                Snackbar.Add("Producto dado de baja.", Severity.Success);
                await Cargar();
            }
            else
            {
                Snackbar.Add(await r.Content.ReadAsStringAsync(), Severity.Error);
            }
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Error de conexión: {ex.Message}", Severity.Error);
        }
    }
}