@inherits LayoutComponentBase
@using Pizzeria.Cliente.Web.Servicios
@inject IAuthService AuthService
@inject NavigationManager Nav

<MudThemeProvider Theme="_tema" IsDarkMode="true" />
<MudPopoverProvider />
<MudDialogProvider />
<MudSnackbarProvider />

<MudLayout>
    <MudAppBar Elevation="1">
        <MudText Typo="Typo.h6" Style="font-family:Poppins,sans-serif;font-weight:700">🍕 Pizzería · Caja</MudText>

        <AuthorizeView Roles="Cajero">
            <MudButton Href="/" Color="Color.Inherit" Class="ml-4">Caja</MudButton>
        </AuthorizeView>

        <AuthorizeView Roles="Administrador">
            <MudButton Href="/" Color="Color.Inherit" Class="ml-4">Inicio</MudButton>
        </AuthorizeView>

        <AuthorizeView Roles="Administrador">
            <MudButton Href="/Productos" Color="Color.Inherit">Productos</MudButton>
            <MudButton Href="/Categoria" Color="Color.Inherit">Categorías</MudButton>
            <MudButton Href="/Proveedores" Color="Color.Inherit">Proveedores</MudButton>
            <MudButton Href="/Usuarios" Color="Color.Inherit">Usuarios</MudButton>
        </AuthorizeView>

        <MudSpacer />

        <AuthorizeView>
            <Authorized>
                <MudText Typo="Typo.body2" Class="mr-3">@NombreUsuario(context.User)</MudText>
                <MudButton Color="Color.Inherit" Variant="Variant.Outlined" Size="Size.Small" OnClick="CerrarSesion">Salir</MudButton>
            </Authorized>
        </AuthorizeView>
    </MudAppBar>

    <MudMainContent>
        @* El contenedor centra el contenido y le da aire arriba, abajo y a los costados *@
        <MudContainer MaxWidth="MaxWidth.ExtraLarge" Class="mt-6 mb-8">
            @Body
        </MudContainer>
    </MudMainContent>
</MudLayout>

@code {
    private readonly MudTheme _tema = new()
    {
        PaletteDark = new PaletteDark
        {
            Primary = "#FF5722",           // naranja pepperoni: botones principales
            Secondary = "#FFC107",         // amarillo queso: precios y detalles
            Background = "#0D0D0D",        // fondo de la web
            Surface = "#161616",           // tarjetas, menús y diálogos
            TextPrimary = "#FFFFFF",
            TextSecondary = "#9E9E9E",
            AppbarBackground = "#121212"
        },
        Typography = new Typography
        {
            Default = new DefaultTypography { FontFamily = new[] { "Inter", "sans-serif" } },
            H1 = new H1Typography { FontFamily = new[] { "Poppins", "sans-serif" }, FontWeight = "800" },
            H2 = new H2Typography { FontFamily = new[] { "Poppins", "sans-serif" }, FontWeight = "700" },
            H3 = new H3Typography { FontFamily = new[] { "Poppins", "sans-serif" }, FontWeight = "600" },
            H5 = new H5Typography { FontFamily = new[] { "Poppins", "sans-serif" }, FontWeight = "600" },
            H6 = new H6Typography { FontFamily = new[] { "Poppins", "sans-serif" }, FontWeight = "600" },
            Button = new ButtonTypography { FontFamily = new[] { "Poppins", "sans-serif" }, FontWeight = "600", TextTransform = "none" }
        },
        LayoutProperties = new LayoutProperties { DefaultBorderRadius = "12px" }
    };

    // Muestra el email si el token lo trae; si no, el rol
    private static string NombreUsuario(System.Security.Claims.ClaimsPrincipal usuario)
    {
        var claim = usuario.Claims.FirstOrDefault(c =>
            c.Type == "email" ||
            c.Type == System.Security.Claims.ClaimTypes.Email ||
            c.Type == System.Security.Claims.ClaimTypes.Name);

        return claim?.Value ?? usuario.Claims
            .FirstOrDefault(c => c.Type == System.Security.Claims.ClaimTypes.Role)?.Value ?? "Usuario";
    }

    private async Task CerrarSesion()
    {
        await AuthService.LogoutAsync();
        Nav.NavigateTo("/login");
    }
}