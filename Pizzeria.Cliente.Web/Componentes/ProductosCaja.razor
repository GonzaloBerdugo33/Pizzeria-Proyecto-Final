@using System.Net.Http.Json
@using Pizzeria.Cliente.Web.DTOs
@using Pizzeria.Cliente.Web.Servicios
@inject HttpClient Http
@implements IDisposable

<MudText Typo="Typo.h6" Class="mb-2">Productos</MudText>

<MudTextField T="string" @bind-Value="filtro" Immediate="true" Variant="Variant.Outlined" Margin="Margin.Dense"
              Placeholder="Buscar producto..." Adornment="Adornment.Start"
              AdornmentIcon="@Icons.Material.Filled.Search" Class="mb-2" />

<div class="d-flex flex-wrap mb-3" style="gap:6px">
    <MudButton Size="Size.Small" Color="Color.Primary"
               Variant="@(categoria == "" ? Variant.Filled : Variant.Outlined)"
               OnClick="() => categoria = string.Empty">Todas</MudButton>
    @foreach (var c in Categorias)
    {
        <MudButton Size="Size.Small" Color="Color.Primary"
                   Variant="@(categoria == c ? Variant.Filled : Variant.Outlined)"
                   OnClick="() => categoria = c">@c</MudButton>
    }
</div>

@if (error is not null)
{
    <MudAlert Severity="Severity.Error">@error</MudAlert>
}
else if (productos is null)
{
    <MudProgressCircular Indeterminate="true" />
}
else if (!Visibles.Any())
{
    <MudText Color="Color.Secondary">No hay productos para mostrar.</MudText>
}
else
{
    <MudGrid Spacing="2">
        @foreach (var p in Visibles)
        {
            var puede = CarritoVenta.PuedePedirse(p);
            <MudItem xs="6">
                <MudPaper Class="pa-3 d-flex flex-column" Style="@(puede ? "height:100%" : "height:100%;opacity:0.6")" Elevation="1">
                    <MudText Typo="Typo.subtitle2"><b>@p.Nombre</b></MudText>
                    <MudText Typo="Typo.caption" Color="Color.Secondary">@p.CategoriaNombre · @(p.Stock == 0 ? "Agotado" : $"Stock {p.Stock}")</MudText>
                    <MudText Typo="Typo.subtitle1" Class="my-1"><b>@Formato.Dinero(p.Precio)</b></MudText>
                    <MudButton Variant="Variant.Filled" Color="Color.Primary" Size="Size.Small" Class="mt-auto"
                               Disabled="@(!puede)" OnClick="() => OnAgregar.InvokeAsync(p)">
                        @(puede ? "Agregar" : (p.Stock == 0 ? "Agotado" : "No disponible"))
                    </MudButton>
                </MudPaper>
            </MudItem>
        }
    </MudGrid>
}

@code {
    // El padre (la página de caja) decide qué hacer cuando se agrega un producto
    [Parameter] public EventCallback<ProductoDTO> OnAgregar { get; set; }

    private List<ProductoDTO>? productos;
    private string filtro = string.Empty;
    private string categoria = string.Empty;
    private string? error;

    // Solo productos activos (los dados de baja no aparecen)
    private IEnumerable<ProductoDTO> Activos => (productos ?? new()).Where(p => p.Activo);

    private IEnumerable<string> Categorias =>
        Activos.Select(p => p.CategoriaNombre ?? "Otros").Distinct().OrderBy(c => c);

    private IEnumerable<ProductoDTO> Visibles => Activos.Where(p =>
        (categoria == "" || (p.CategoriaNombre ?? "Otros") == categoria) &&
        (string.IsNullOrWhiteSpace(filtro) || p.Nombre.Contains(filtro.Trim(), StringComparison.OrdinalIgnoreCase)));

    private readonly CancellationTokenSource _cts = new();

    protected override async Task OnInitializedAsync()
    {
        await Cargar();
        _ = Sondear(_cts.Token);
    }

    // Cada 5 segundos vuelve a pedir los productos para ver el stock actualizado
    private async Task Sondear(CancellationToken ct)
    {
        using var timer = new PeriodicTimer(TimeSpan.FromSeconds(5));
        try
        {
            while (await timer.WaitForNextTickAsync(ct))
            {
                await Cargar();
                await InvokeAsync(StateHasChanged);
            }
        }
        catch (OperationCanceledException) { }
    }

    private async Task Cargar()
    {
        try
        {
            productos = await Http.GetFromJsonAsync<List<ProductoDTO>>("api/Producto?pagina=1&tamanoPagina=1000") ?? new();
            error = null;
        }
        catch (Exception ex)
        {
            // Un corte momentáneo no borra lo que ya se estaba mostrando
            if (productos is null) error = $"No se pudieron cargar los productos: {ex.Message}";
        }
    }

    public async Task Recargar()
    {
        await Cargar();
        StateHasChanged();
    }


    // Al salir de la página se detiene el temporizador
    public void Dispose() => _cts.Cancel();
}